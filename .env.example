# ==============================================================================
# Multimodal Evidence-Aware Misinformation Verification System
# Production Environment Configuration Template
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Multimodal Evidence-Aware Misinformation Verification System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=false
LOG_LEVEL="INFO"

# Server Bindings
HOST="0.0.0.0"
PORT=8000
WORKERS=4

# Database Connection (Async SQLite default, or PostgreSQL for enterprise scale)
# SQLite: sqlite+aiosqlite:///./verification.sqlite3
# Postgres: postgresql+asyncpg://user:password@localhost:5432/truthlab
DATABASE_URL="sqlite+aiosqlite:///./verification.sqlite3"

# Ingestion Size & Duration Limits (Resource Protection)
MAX_TEXT_LENGTH=20000
MAX_IMAGE_SIZE_BYTES=15728640        # 15 MB
MAX_VIDEO_SIZE_BYTES=62914560        # 60 MB
MAX_VIDEO_DURATION_SECONDS=90

# Anti-SSRF URL Boundaries
MAX_URL_RESPONSE_BYTES=5242880       # 5 MB
URL_REQUEST_TIMEOUT_SECONDS=8.0
MAX_URL_REDIRECTS=3

# External Verification APIs (Optional - Local rule & NLI heuristics active by default)
# GOOGLE_FACTCHECK_API_KEY="AIzaSy..."
# TAVILY_API_KEY="tvly-..."
GOOGLE_FACTCHECK_API_KEY=
TAVILY_API_KEY=

# Algorithmic Verification Thresholds
CHECKWORTHY_THRESHOLD=0.60
EVIDENCE_SUFFICIENCY_THRESHOLD=1.20
STANCE_SUPPORT_THRESHOLD=0.70
STANCE_REFUTE_THRESHOLD=0.65
TEMPORAL_OUTDATED_DAYS=180
SYNTHETIC_INDICATOR_THRESHOLD=0.75

# Uncertainty & Reliability Calibration
TEMPERATURE_SCALING_PARAMETER=1.85
UNCERTAINTY_ENTROPY_THRESHOLD=0.75
MIN_CITATIONS_FOR_SUFFICIENCY=2

# Media Cache & Storage Cleanup
CACHE_EXPIRATION_HOURS=24
UPLOAD_PURGE_MAX_AGE_SECONDS=7200    # 2 Hours
